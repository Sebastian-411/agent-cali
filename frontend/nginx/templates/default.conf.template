# La imagen oficial de nginx procesa este archivo con envsubst al arrancar el
# contenedor y lo escribe en /etc/nginx/conf.d/default.conf. Gracias a eso
# BACKEND_URL se resuelve en tiempo de ejecución: se puede apuntar a otro
# backend sin reconstruir la imagen.
#
# NGINX_ENVSUBST_FILTER limita la sustitución a nuestras variables, para que las
# propias de nginx ($host, $uri, ...) queden intactas.

server {
    listen 80;
    server_name _;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Resolución del backend EN CADA PETICIÓN, no al arrancar.
    #
    # Con `proxy_pass http://backend:3000` literal, nginx resuelve el nombre una
    # sola vez al iniciar: (a) no arranca si el backend todavía no existe, y
    # (b) si el backend se reinicia con otra IP, se queda proxeando a la IP
    # vieja hasta que reinicies también el frontend. Poner el destino en una
    # variable obliga a nginx a consultar el resolver en cada petición.
    #
    # NGINX_RESOLVER por defecto es el DNS interno de Docker (127.0.0.11).
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # El navegador habla siempre con este mismo origen: por eso, en el despliegue
    # por defecto, el backend no necesita CORS.
    location /api {
        # BACKEND_URL debe ser sólo esquema://host:puerto, sin ruta: con
        # proxy_pass por variable la ruta original la aporta $request_uri.
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream$request_uri;

        proxy_ssl_server_name on;             # SNI, por si BACKEND_URL es https
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
