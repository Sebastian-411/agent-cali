# =============================================================
# Frontend — panel de verificación
# Copiar a frontend/.env. Aquí NO va ningún secreto: todo lo que esté en un
# archivo VITE_* termina dentro del bundle que descarga el navegador.
# La ADMIN_API_KEY la escribe cada administrador al entrar al panel.
# =============================================================

# --- Runtime (contenedor nginx) ---
# A dónde proxea nginx las llamadas a /api. Se sustituye al ARRANCAR el
# contenedor, así que puedes cambiar el backend sin reconstruir la imagen.
# En docker compose el host es el nombre del servicio.
# Debe ser sólo esquema://host:puerto, SIN ruta.
BACKEND_URL=http://backend:3000

# Servidor DNS que nginx consulta para resolver BACKEND_URL en cada petición.
# 127.0.0.11 es el DNS interno de Docker. Fuera de Docker (o con DNS público),
# apúntalo al resolver de tu red, p. ej. 8.8.8.8 o el de tu VPC.
NGINX_RESOLVER=127.0.0.11

# --- Build / desarrollo ---
# Origen al que el NAVEGADOR le habla. Vacío = mismo origen, es decir el proxy
# /api de nginx (recomendado: no necesita CORS).
# Sólo ponle un valor si el navegador debe llamar al backend directamente en
# otro dominio; en ese caso hay que configurar CORS_ORIGIN en el backend.
# Ojo: es una variable de BUILD. En docker se pasa como build arg, no como
# variable de entorno del contenedor.
VITE_API_BASE_URL=

# Destino del proxy del servidor de desarrollo (npm run dev). Sólo local.
VITE_DEV_PROXY_TARGET=http://localhost:3000
