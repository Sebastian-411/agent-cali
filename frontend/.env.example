# =============================================================
# Panel — copiar a frontend/.env
# Una sola variable obligatoria. Aquí NO va ningún secreto: todo lo que se
# compila en el bundle lo puede leer cualquiera que abra el panel.
# =============================================================

# A dónde proxea nginx las llamadas a /api. Sólo esquema://host:puerto, sin ruta.
# Se resuelve al arrancar el contenedor: cambiarlo no requiere reconstruir.
BACKEND_URL=http://backend:3000


# =============================================================
# OPCIONAL
# =============================================================

# DNS que nginx consulta para resolver BACKEND_URL en cada petición.
# 127.0.0.11 es el DNS interno de Docker; fuera de Docker, el de tu red.
#   NGINX_RESOLVER=127.0.0.11

# Origen al que llama el NAVEGADOR. Vacío = mismo origen, o sea el proxy /api
# (recomendado: no necesita CORS). Es variable de BUILD, se pasa como build arg.
#   VITE_API_BASE_URL=

# Destino del proxy de `npm run dev`. Sólo desarrollo local.
#   VITE_DEV_PROXY_TARGET=http://localhost:3000
