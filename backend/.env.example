# =============================================================
# Backend — agente de monitoreo y verificación
# Copiar a backend/.env. No compartir con el contenedor del frontend:
# aquí viven todos los secretos.
# =============================================================

# --- Base de datos ---
# La base puede estar compartida con otros proyectos: TODO este sistema vive
# dentro de DB_SCHEMA y no toca nada fuera de ahí. Usa un nombre propio.
# El esquema se crea solo al arrancar; no hay que prepararlo a mano.
DATABASE_URL=postgres://usuario:clave@host:5432/labs?sslmode=disable
DB_SCHEMA=agente_grupos
PORT=3000

# --- Evolution API ---
# IMPORTANTE: usa una instancia DEDICADA a este proyecto.
# Evolution admite un solo webhook por instancia; apuntar el de una instancia
# en producción rompe la integración existente.
EVOLUTION_API_URL=https://tu-evolution-api.ejemplo.com
EVOLUTION_API_KEY=cambiar
EVOLUTION_INSTANCE=agente_grupos

# URL pública de ESTE backend. Evolution la usa para entregar el webhook.
# Sin barra final.
PUBLIC_URL=https://tu-tunel.ngrok.app

# --- Secretos ---
# Generar con: openssl rand -hex 32
WEBHOOK_TOKEN=cambiar
ADMIN_API_KEY=cambiar
SENDER_SALT=cambiar

# --- CORS ---
# Sólo necesario si el navegador llama al backend en OTRO origen, es decir si
# NO usas el proxy /api de nginx del frontend. Lista separada por comas.
# Vacío = CORS deshabilitado (recomendado cuando el frontend proxea).
# Ejemplo: CORS_ORIGIN=https://panel.tudominio.com
CORS_ORIGIN=

# --- Modelo (Google Gemini) ---
# Clave: https://aistudio.google.com/apikey
GEMINI_API_KEY=cambiar

# Modelo por defecto para las dos etapas del agente.
#   gemini-2.5-flash       equilibrio precio/calidad, recomendado
#   gemini-2.5-flash-lite  el más barato y rápido, para volumen alto
#   gemini-2.5-pro         el más capaz, para el agrupamiento y la redacción
GEMINI_MODEL=gemini-2.5-flash

# Modelo por etapa (opcional). Vacío = usa GEMINI_MODEL.
# Clasificar es volumen alto y decisión sencilla; agrupar y redactar el claim es
# donde se nota un modelo mejor. Una combinación razonable:
#   GEMINI_CLASSIFY_MODEL=gemini-2.5-flash-lite
#   GEMINI_CLUSTER_MODEL=gemini-2.5-pro
GEMINI_CLASSIFY_MODEL=
GEMINI_CLUSTER_MODEL=

# Presupuesto de razonamiento por etapa.
#   0  = sin razonamiento (más barato y rápido)
#   -1 = dinámico, el modelo decide
#   N  = tope en tokens
# Ojo: gemini-2.5-pro NO admite 0 (su mínimo es 128). Si usas pro, pon -1.
GEMINI_CLASSIFY_THINKING_BUDGET=0
GEMINI_CLUSTER_THINKING_BUDGET=-1

# Sólo para apuntar a un proxy o endpoint compatible. Vacío = API oficial.
GEMINI_BASE_URL=

# --- Pipeline ---
PIPELINE_ENABLED=true
PIPELINE_TICK_MS=60000
# Ventana de agregación: un mensaje espera esto antes de procesarse (requisito 19).
AGGREGATION_DEBOUNCE_SECONDS=300
PIPELINE_BATCH_SIZE=40
CLUSTER_WINDOW_HOURS=8
# Fuentes independientes mínimas para publicar encuesta (los CRITICAL se saltan esto).
MIN_SOURCES_TO_PUBLISH=2
POLL_OPEN_MINUTES=90
MIN_INFORMED_VOTES=5
# Retención de mensajes crudos en días. 0 = no borrar.
MESSAGE_RETENTION_DAYS=30

LOG_LEVEL=info
