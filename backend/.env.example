# =============================================================
# Backend — copiar a backend/.env
# Estas 7 son las únicas obligatorias. Todo lo demás tiene un valor por defecto
# razonable; mira el bloque opcional al final sólo si necesitas ajustar algo.
# =============================================================

# Base de datos. Puede estar compartida con otros proyectos: todo este sistema
# vive dentro de un esquema propio, que se crea solo al arrancar.
DATABASE_URL=postgres://usuario:clave@host:5432/labs?sslmode=disable

# Evolution API. Usa una instancia DEDICADA a este proyecto: Evolution admite un
# solo webhook por instancia, y apuntar el de otra rompe esa integración.
EVOLUTION_API_URL=https://tu-evolution-api.ejemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=agente_grupos

# URL pública de ESTE backend, sin barra final. Es a donde Evolution entrega los
# mensajes: el dominio del backend, NO el del panel.
PUBLIC_URL=https://agente-api.tudominio.com

# Clave del panel, la que escriben los administradores al entrar.
#   openssl rand -hex 32
ADMIN_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=


# =============================================================
# OPCIONAL — nada de esto hace falta para arrancar.
# =============================================================

# Esquema de Postgres. Cámbialo si el nombre ya está tomado en tu base.
#   DB_SCHEMA=agente_grupos

# Modelo. Por defecto gemini-2.5-flash en las dos etapas del agente. Clasificar
# es volumen alto y decisión sencilla; agrupar y redactar el claim es donde se
# nota un modelo mejor.
#   GEMINI_MODEL=gemini-2.5-flash
#   GEMINI_CLASSIFY_MODEL=gemini-2.5-flash-lite
#   GEMINI_CLUSTER_MODEL=gemini-2.5-pro
# Razonamiento: 0 = ninguno, -1 = dinámico, N = tope en tokens.
# Ojo: gemini-2.5-pro NO admite 0 (su mínimo es 128).
#   GEMINI_CLASSIFY_THINKING_BUDGET=0
#   GEMINI_CLUSTER_THINKING_BUDGET=-1

# Comportamiento del agente.
#   PIPELINE_ENABLED=true              # false = ingiere y guarda, sin llamar al modelo ni publicar
#   AGGREGATION_DEBOUNCE_SECONDS=300   # cuánto espera un mensaje antes de procesarse
#   MIN_SOURCES_TO_PUBLISH=2           # fuentes independientes para publicar (CRITICAL se salta esto)
#   POLL_OPEN_MINUTES=90               # duración de la encuesta
#   MIN_INFORMED_VOTES=5               # votos Sí+No para declarar SUPPORTED/DISPUTED
#   MESSAGE_RETENTION_DAYS=30          # retención de mensajes crudos; 0 = no borrar
#   PIPELINE_TICK_MS=60000
#   PIPELINE_BATCH_SIZE=40
#   CLUSTER_WINDOW_HOURS=8

# CORS. Sólo si el panel llama al backend desde otro dominio en vez de usar su
# proxy /api. Vacío = deshabilitado, que es lo correcto por defecto.
#   CORS_ORIGIN=https://panel.tudominio.com

# Estos dos se generan solos en el primer arranque y quedan guardados en la base.
# Defínelos únicamente si necesitas fijarlos, por ejemplo para replicar entornos.
#   WEBHOOK_TOKEN=
#   SENDER_SALT=      # cambiarlo rompe la deduplicación de fuentes y votos

#   PORT=3000
#   LOG_LEVEL=info
